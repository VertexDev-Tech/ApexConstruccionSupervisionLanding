# ============================================================================
# CONFIGURACIÓN DE BREVO (SENDINBLUE) PARA EL FORMULARIO DE CONTACTO
# ============================================================================
# 1. Inicia sesión en tu cuenta de Brevo (https://app.brevo.com/)
# 2. Ve a "SMTP & API" -> "API Keys" y genera una clave API v3 (xkeysib-...)
# 3. En Vercel -> Settings -> Environment Variables, agrega:

BREVO_API_KEY=xkeysib-tu_api_key_de_brevo_aqui

# Correo receptor donde llegarán todas las solicitudes desde la web
BREVO_TO_EMAIL=contacto@apex.com.pe
BREVO_TO_NAME="APEX Construcción y Supervisión"

# Correo remitente verificado en tu cuenta de Brevo (Senders & IP)
BREVO_SENDER_EMAIL=contacto@apex.com.pe
BREVO_SENDER_NAME="Web APEX Construcción y Supervisión"
